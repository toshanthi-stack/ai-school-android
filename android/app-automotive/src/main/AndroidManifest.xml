<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- This flavor installs ONLY on Android Automotive OS head units. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        VHAL window-position monitoring.
        CONTROL_CAR_WINDOWS is a signature|privileged permission: it is granted
        only on OEM/system-signed (or priv-app allowlisted) builds. The app
        checks for it at runtime (CabinWindowMonitor) and degrades gracefully
        when running as a regular Play-delivered media app.
    -->
    <uses-permission android:name="android.car.permission.CONTROL_CAR_WINDOWS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!-- Declares this package as an automotive media app to the IVI. -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!-- Runtime linkage to the framework Car API (android.car.jar). -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!--
            Driver-facing media flow: the vehicle's native IVI media templates
            render everything via AISchoolMediaService below. No text entry,
            keyboard, clipboard, or copy-paste surface is used in that flow.

            The VW-styled catalog screen is a separate "design preview" of the
            in-car UI direction. It carries a LAUNCHER entry so it shows in the
            head unit's app grid and Android Studio offers a run configuration
            for this module. (The driver-safe media experience is the service.)
        -->
        <activity
            android:name=".vw.VwCatalogActivity"
            android:exported="true"
            android:label="AI School"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Branded artwork provider. Read-only, serves only static pillar art
            so the system Media Center can load browse/Now-Playing images that a
            cross-package android.resource:// URI cannot satisfy. Exported so the
            system UI process can read it; no sensitive data is exposed.
        -->
        <provider
            android:name=".ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />

        <service
            android:name=".AISchoolMediaService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
